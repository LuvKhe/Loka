# ============================================================
# Loka Web — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — server-only (NEVER expose to the browser or commit to git)
# Used exclusively in API routes that need to bypass RLS (e.g. creating friendships).
# Find this in your Supabase project: Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for QR codes, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional contact address shown on the Terms and Privacy pages
NEXT_PUBLIC_SUPPORT_EMAIL=
